<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<!-- the sample apps live in this folder but are separate projects -->
		<DefaultItemExcludes>$(DefaultItemExcludes);samples/**</DefaultItemExcludes>
	</PropertyGroup>
  <!-- Both frameworks are built until every consumer runs on .NET 10: the net6.0 build keeps exactly the package
       versions it had, the net10.0 build takes the matching 10.x packages. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <MsExtHostingVersion>6.0.0</MsExtHostingVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MsExtHostingVersion>10.0.12</MsExtHostingVersion>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="log4net" Version="3.3.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MsExtHostingVersion)" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\CurrenciesLib\CurrenciesLib.csproj" />
	</ItemGroup>
	<PropertyGroup>
		<RepositoryUrl>https://github.com/PayGram/PayGram.Public</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>3.0.0</Version>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
</Project>
